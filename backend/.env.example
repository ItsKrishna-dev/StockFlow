# Database (Neon / PostgreSQL with asyncpg)
DATABASE_URL=postgresql+asyncpg://neondb_owner:YOUR_ROTATED_PASSWORD@YOUR_NEON_HOST/neondb?sslmode=require&channel_binding=require

# Auth / JWT
SECRET_KEY=GENERATE_A_LONG_RANDOM_VALUE
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (Comma-separated list of allowed origins. Note: *.vercel.app is also allowed via regex)
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# AI Copilot (Groq free tier)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Email Alerts (Optional - Gmail App Password or SMTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME="StockSense Inventory"
MAIL_TLS=True

ENVIRONMENT=production